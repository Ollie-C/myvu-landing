---
import { APP_URL, campaignHeroes, links } from '../config';

const initialHeroIndex = campaignHeroes.findIndex(hero => hero.id === 'shogun');
const initialHeroes = campaignHeroes.filter(hero => hero.mediaType === 'tv_show');
const trustLinks = [
  { href: links.privacy, label: 'Privacy' },
  { href: links.terms, label: 'Terms' },
  { href: links.contact, label: 'Contact' },
  { href: links.attribution, label: 'Attribution' }
];
---

<section
  class="campaign-hero"
  aria-label="Score a featured title"
  data-campaign-hero
  data-app-url={APP_URL}
>
  <div class="campaign-hero__backdrops" aria-hidden="true">
    {campaignHeroes.map((hero, index) => (
      <div
        class:list={['campaign-hero__backdrop', index === initialHeroIndex && 'is-active']}
        data-hero-item
        data-index={index}
        data-id={hero.id}
        data-media-type={hero.mediaType}
        data-tmdb-id={hero.tmdbId}
        data-title={hero.title}
        data-credit-url={hero.creditUrl}
      >
        <picture>
          <source media="(min-width: 1024px)" srcset={index === initialHeroIndex ? `/heroes/${hero.id}-lg.jpg` : undefined} data-srcset={`/heroes/${hero.id}-lg.jpg`} />
          <img
            src={index === initialHeroIndex ? `/heroes/${hero.id}-sm.jpg` : undefined}
            data-src={`/heroes/${hero.id}-sm.jpg`}
            alt=""
            loading={index === initialHeroIndex ? 'eager' : 'lazy'}
            fetchpriority={index === initialHeroIndex ? 'high' : 'auto'}
          />
        </picture>
      </div>
    ))}
    <canvas class="campaign-hero__pixel-canvas" data-pixel-canvas aria-hidden="true"></canvas>
    <div class="campaign-hero__scrim"></div>
  </div>

  <div class="campaign-hero__stage is-copy-visible" data-hero-stage>
    <div class="campaign-hero__identity" aria-live="polite">
      <div class="campaign-hero__poster-stack">
        {campaignHeroes.map((hero, index) => (
          <img
            src={index === initialHeroIndex ? `/heroes/${hero.id}-poster.jpg` : undefined}
            data-src={`/heroes/${hero.id}-poster.jpg`}
            alt={`${hero.title} poster`}
            class:list={['campaign-hero__poster', index === initialHeroIndex && 'is-active']}
            aria-hidden={index === initialHeroIndex ? 'false' : 'true'}
            loading={index === initialHeroIndex ? 'eager' : 'lazy'}
            data-poster={index}
          />
        ))}
      </div>

      <div class="campaign-hero__copy">
        {campaignHeroes.map((hero, index) => (
          <div class:list={['campaign-hero__details', index === initialHeroIndex && 'is-active']} data-details={index}>
            <h1>
              <button type="button" class="campaign-hero__title" aria-expanded="false" aria-controls={`title-info-${index}`} data-title-trigger>
                {hero.title}<span class="campaign-hero__info-mark" aria-hidden="true">↗</span>
              </button>
            </h1>
            <p id={`title-info-${index}`} class="campaign-hero__kicker" data-title-info>
              {hero.mediaType === 'movie' ? 'Film' : 'Series'} · {hero.year}<br />{hero.byline}
            </p>
          </div>
        ))}
      </div>
    </div>

    <form class="campaign-hero__rating" data-rating-form>
      <label for="campaign-score" class="sr-only" data-score-label>Your score for Shōgun</label>
      <div class="campaign-hero__score-display">
        <input
          id="campaign-score"
          name="score"
          type="number"
          min="0"
          max="10"
          step="0.1"
          required
          inputmode="decimal"
          value="8.3"
          autocomplete="off"
          aria-describedby="score-placement"
          data-score-input
        />
        <span class="campaign-hero__score-total">/10</span>
        <button class="campaign-hero__rate-button" type="submit" aria-label="Save your score and open tenagain" data-score-submit hidden disabled>
          <svg viewBox="0 0 24 48" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m4 5 17 19L4 43" /></svg>
        </button>
      </div>
      <p class="campaign-hero__placement" id="score-placement" data-score-placement title="Compared with community chart scores rounded to one decimal place." aria-live="polite" aria-atomic="true" hidden></p>
      <p class="campaign-hero__error" data-rating-error role="alert"></p>
    </form>
  </div>

  <div class="campaign-hero__carousel">
    <div class="campaign-hero__dots" role="tablist" aria-label="Featured titles" data-carousel-controls>
      {initialHeroes.map((hero, position) => (
        <button
          type="button"
          class:list={['campaign-hero__dot', position === 2 && 'is-active']}
          data-dot={position + 3}
          data-dot-position={position}
          role="tab"
          aria-selected={position === 2 ? 'true' : 'false'}
          aria-label={`Show ${hero.title}`}
        >
          <span class="sr-only">{hero.title}</span>
        </button>
      ))}
    </div>
  </div>

  <div class="campaign-hero__footer">
    <nav aria-label="Trust links">
      {trustLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href={campaignHeroes[initialHeroIndex].creditUrl} target="_blank" rel="noopener noreferrer" data-artwork-credit>Artwork via TMDB ↗</a>
    </nav>
  </div>
</section>

<script>
  import {
    isScoreDistribution,
    scorePlacement,
    ordinal,
    type ScoreDistribution,
  } from '../scripts/scorePlacement';
  type MediaMode = 'movie' | 'tv_show';
  type PixelHeroController = ReturnType<
    (typeof import('../scripts/pixelHero'))['createPixelHero']
  >;
  type HeroItem = {
    node: HTMLElement;
    index: number;
    id: string;
    mediaType: MediaMode;
    tmdbId: number;
    title: string;
  };

  const root = document.querySelector<HTMLElement>('[data-campaign-hero]');
  const stage = root?.querySelector<HTMLElement>('[data-hero-stage]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-pixel-canvas]');
  const form = root?.querySelector<HTMLFormElement>('[data-rating-form]');
  const scoreInput = root?.querySelector<HTMLInputElement>('[data-score-input]');
  const scoreSubmit = root?.querySelector<HTMLButtonElement>(
    '[data-score-submit]',
  );
  const scoreLabel = root?.querySelector<HTMLElement>('[data-score-label]');
  const scorePlacementText = root?.querySelector<HTMLElement>(
    '[data-score-placement]',
  );
  const artworkCredit = root?.querySelector<HTMLAnchorElement>(
    '[data-artwork-credit]',
  );
  const ratingError = root?.querySelector<HTMLElement>('[data-rating-error]');
  const carouselControls = root?.querySelector<HTMLElement>(
    '[data-carousel-controls]',
  );
  const modeButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-mode-option]'),
  );
  const heroItems: HeroItem[] = root
    ? Array.from(root.querySelectorAll<HTMLElement>('[data-hero-item]')).map(
        (node) => ({
          node,
          index: Number(node.dataset.index),
          id: node.dataset.id ?? '',
          mediaType: node.dataset.mediaType === 'tv_show' ? 'tv_show' : 'movie',
          tmdbId: Number(node.dataset.tmdbId),
          title: node.dataset.title ?? '',
        }),
      )
    : [];
  const details = root
    ? Array.from(root.querySelectorAll<HTMLElement>('[data-details]'))
    : [];
  const posters = root
    ? Array.from(root.querySelectorAll<HTMLElement>('[data-poster]'))
    : [];
  const dots = root
    ? Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'))
    : [];
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let pixelHero: PixelHeroController | null = null;
  let pixelHeroPromise: Promise<PixelHeroController | null> | null = null;
  const indicesByMode: Record<MediaMode, number[]> = {
    movie: heroItems
      .filter((item) => item.mediaType === 'movie')
      .map((item) => item.index),
    tv_show: heroItems
      .filter((item) => item.mediaType === 'tv_show')
      .map((item) => item.index),
  };
  const activeByMode: Record<MediaMode, number> = {
    movie: indicesByMode.movie[0] ?? 0,
    tv_show:
      heroItems.find((item) => item.id === 'shogun')?.index ??
      indicesByMode.tv_show[0] ??
      3,
  };

  let activeMode: MediaMode = 'tv_show';
  let activeIndex = activeByMode.tv_show;
  let scoreEdited = false;
  let rotationTimer: number | undefined;
  let resizeTimer: number | undefined;
  let controlsFocused = false;

  function getPixelHero() {
    if (pixelHero) return Promise.resolve(pixelHero);
    if (!canvas) return Promise.resolve(null);
    if (!pixelHeroPromise) {
      pixelHeroPromise = import('../scripts/pixelHero').then(
        ({ createPixelHero }) => {
          pixelHero = createPixelHero(canvas);
          return pixelHero;
        },
      );
    }
    return pixelHeroPromise;
  }

  function appUrl(pathname: string) {
    return `${root?.dataset.appUrl ?? ''}${pathname}`;
  }

  function updateAppLinks() {
    const discoverPath = `/discover?mediaType=${activeMode}`;
    const signInLink =
      document.querySelector<HTMLAnchorElement>('[data-app-signin]');
    if (signInLink) {
      const signInUrl = new URL(appUrl('/login'));
      signInUrl.searchParams.set('redirect', discoverPath);
      signInLink.href = signInUrl.toString();
    }
  }

  function preloadAround(index: number) {
    const modeIndices = indicesByMode[activeMode];
    const position = modeIndices.indexOf(index);
    const preloadIndices = [
      index,
      modeIndices[(position + 1) % modeIndices.length],
    ];
    const large = window.matchMedia('(min-width: 1024px)').matches;
    for (const preloadIndex of preloadIndices) {
      const item = heroItems[preloadIndex];
      if (!item) continue;
      const backdrop = new Image();
      backdrop.src = `/heroes/${item.id}-${large ? 'lg' : 'sm'}.jpg`;
      const poster = new Image();
      poster.src = `/heroes/${item.id}-poster.jpg`;
    }
  }

  function clearRotation() {
    if (rotationTimer !== undefined) window.clearTimeout(rotationTimer);
    rotationTimer = undefined;
  }

  function scheduleRotation() {
    clearRotation();
    if (
      reducedMotion.matches ||
      controlsFocused ||
      scoreEdited ||
      document.hidden ||
      (document.body.dataset.landingView &&
        document.body.dataset.landingView !== 'score')
    )
      return;
    rotationTimer = window.setTimeout(() => select(nextIndex()), 8000);
  }

  function nextIndex(direction = 1) {
    const modeIndices = indicesByMode[activeMode];
    const position = modeIndices.indexOf(activeIndex);
    return modeIndices[
      (position + direction + modeIndices.length) % modeIndices.length
    ];
  }

  function revealCopy() {
    stage?.classList.add('is-copy-visible');
  }

  function select(index: number, animate = true) {
    const selected = heroItems[index];
    if (!selected) return;
    clearRotation();
    pixelHero?.cancel();
    const titleChanged = activeIndex !== index;
    activeIndex = index;
    activeMode = selected.mediaType;
    activeByMode[activeMode] = index;
    // Controls stay usable while the optional background effect loads or plays.
    revealCopy();
    canvas?.classList.remove('is-active');
    if (titleChanged) resetScore();
    if (scoreLabel) scoreLabel.textContent = `Your score for ${selected.title}`;
    updatePlacement();
    root
      ?.querySelectorAll<HTMLElement>('[data-title-trigger]')
      .forEach((trigger) => {
        trigger.setAttribute('aria-expanded', 'false');
        trigger.closest('[data-details]')?.classList.remove('is-revealed');
      });
    if (artworkCredit)
      artworkCredit.href =
        selected.node.dataset.creditUrl || 'https://www.themoviedb.org/';
    if (ratingError) ratingError.textContent = '';

    heroItems.forEach((item) =>
      item.node.classList.toggle('is-active', item.index === index),
    );
    const activateImage = (node: HTMLElement) => {
      if (node.dataset.srcset) node.setAttribute('srcset', node.dataset.srcset);
      if (node.dataset.src) node.setAttribute('src', node.dataset.src);
    };
    selected.node
      .querySelectorAll<HTMLElement>('[data-src], [data-srcset]')
      .forEach(activateImage);
    details.forEach((node) =>
      node.classList.toggle('is-active', Number(node.dataset.details) === index),
    );
    posters.forEach((node) => {
      const active = Number(node.dataset.poster) === index;
      if (active) activateImage(node);
      node.classList.toggle('is-active', active);
      node.setAttribute('aria-hidden', String(!active));
    });
    const modeIndices = indicesByMode[activeMode];
    dots.forEach((dot) => {
      const position = Number(dot.dataset.dotPosition);
      const dotIndex = modeIndices[position];
      const item = heroItems[dotIndex];
      if (!item) return;
      dot.dataset.dot = String(dotIndex);
      dot.classList.toggle('is-active', dotIndex === index);
      dot.setAttribute('aria-selected', String(dotIndex === index));
      dot.setAttribute('aria-label', `Show ${item.title}`);
      const label = dot.querySelector('.sr-only');
      if (label) label.textContent = item.title;
      dot.tabIndex = dotIndex === index ? 0 : -1;
    });
    modeButtons.forEach((button) => {
      const active = button.dataset.modeOption === activeMode;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-checked', String(active));
      button.tabIndex = active ? 0 : -1;
    });

    updateAppLinks();
    void loadDistribution(activeMode);
    if (animate) preloadAround(index);

    if (!animate || reducedMotion.matches || !canvas) {
      revealCopy();
      scheduleRotation();
      return;
    }

    const large = window.matchMedia('(min-width: 1024px)').matches;
    const selectionIndex = index;
    void getPixelHero()
      .then((controller) => {
        if (
          activeIndex !== selectionIndex ||
          (document.body.dataset.landingView &&
            document.body.dataset.landingView !== 'score')
        )
          return;
        if (!controller) {
          scheduleRotation();
          return;
        }
        return controller.play(
          `/heroes/${selected.id}-${large ? 'lg' : 'sm'}.jpg`,
          {
            onStart: () => canvas.classList.add('is-active'),
            onProgress: (progress) => {
              if (progress >= 0.42) revealCopy();
            },
            onComplete: () => {
              revealCopy();
              scheduleRotation();
            },
            onError: () => {
              canvas.classList.remove('is-active');
              revealCopy();
              scheduleRotation();
            },
          },
        );
      })
      .catch(() => {
        if (activeIndex === selectionIndex) {
          canvas?.classList.remove('is-active');
          revealCopy();
          scheduleRotation();
        }
      });
  }

  modeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const mode = button.dataset.modeOption === 'tv_show' ? 'tv_show' : 'movie';
      select(activeByMode[mode]);
    });
    button.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const mode: MediaMode = activeMode === 'movie' ? 'tv_show' : 'movie';
      const target = modeButtons.find(
        (candidate) => candidate.dataset.modeOption === mode,
      );
      target?.focus();
      select(activeByMode[mode]);
    });
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', () => select(Number(dot.dataset.dot)));
    dot.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const targetIndex = nextIndex(event.key === 'ArrowRight' ? 1 : -1);
      const target = dots.find(
        (candidate) => Number(candidate.dataset.dot) === targetIndex,
      );
      target?.focus();
      select(targetIndex);
    });
  });

  const distributions = new Map<MediaMode, ScoreDistribution>();
  const loadingDistributions = new Set<MediaMode>();

  function validScore() {
    const raw = scoreInput?.value.trim() ?? '';
    const value = Number(raw);
    return (
      raw !== '' &&
      Number.isFinite(value) &&
      value >= 0 &&
      value <= 10 &&
      Math.abs(value * 10 - Math.round(value * 10)) < 1e-8
    );
  }

  function resetScore() {
    scoreEdited = false;
    if (scoreInput)
      scoreInput.value = (6 + Math.floor(Math.random() * 40) / 10).toFixed(1);
    if (scoreSubmit) {
      scoreSubmit.hidden = true;
      scoreSubmit.disabled = true;
    }
  }

  function updatePlacement() {
    if (!scorePlacementText) return;
    scorePlacementText.hidden = true;
    scorePlacementText.textContent = '';
    const distribution = distributions.get(activeMode);
    if (!validScore() || !distribution?.totalCount || !scoreInput) return;
    const value = Number(scoreInput.value);
    const placement = scorePlacement(value, distribution);
    if (!placement) return;
    const position =
      placement.first === placement.last
        ? `around ${ordinal(placement.first)}`
        : `between ${ordinal(placement.first)} and ${ordinal(placement.last)}`;
    const titles = activeMode === 'movie' ? 'movies' : 'series';
    scorePlacementText.textContent = `A score of ${value.toFixed(1)} would place ${heroItems[activeIndex].title} ${position} among ${placement.total.toLocaleString()} ${titles} on tenagain’s community chart.`;
    scorePlacementText.hidden = false;
  }

  async function loadDistribution(mode: MediaMode) {
    if (distributions.has(mode) || loadingDistributions.has(mode)) return;
    loadingDistributions.add(mode);
    try {
      const url = new URL(appUrl('/api/community/score-distribution'));
      url.searchParams.set('mediaType', mode);
      const response = await fetch(url, {
        credentials: 'omit',
        signal: AbortSignal.timeout(6000),
      });
      if (!response.ok) return;
      const data: unknown = await response.json();
      if (!isScoreDistribution(data)) return;
      distributions.set(mode, data);
      updatePlacement();
    } catch {
      /* A missing chart never blocks scoring. */
    } finally {
      loadingDistributions.delete(mode);
    }
  }

  function updateScore() {
    scoreEdited = true;
    const valid = validScore();
    if (scoreSubmit) {
      scoreSubmit.hidden = !valid;
      scoreSubmit.disabled = !valid;
    }
    if (ratingError) ratingError.textContent = '';
    updatePlacement();
    clearRotation();
  }
  scoreInput?.addEventListener('input', updateScore);
  scoreInput?.addEventListener('focus', () => scoreInput.select());

  details.forEach((detail) => {
    const trigger = detail.querySelector<HTMLButtonElement>(
      '[data-title-trigger]',
    );
    const show = (visible: boolean) => {
      detail.classList.toggle('is-revealed', visible);
      trigger?.setAttribute('aria-expanded', String(visible));
    };
    detail.addEventListener('mouseenter', () => show(true));
    detail.addEventListener('mouseleave', () => {
      if (!detail.contains(document.activeElement)) show(false);
    });
    trigger?.addEventListener('click', () => show(true));
    trigger?.addEventListener('focus', () => show(true));
    trigger?.addEventListener('blur', () => show(false));
    trigger?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') show(false);
    });
  });

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const rawValue = scoreInput?.value.trim() ?? '';
    const value = Number(rawValue);
    if (
      rawValue === '' ||
      !Number.isFinite(value) ||
      value < 0 ||
      value > 10 ||
      !validScore()
    ) {
      if (ratingError) ratingError.textContent = 'Use 0–10 in steps of 0.1.';
      scoreInput?.focus();
      return;
    }

    if (!scoreEdited) return;
    const selected = heroItems[activeIndex];
    const destination = new URL(appUrl('/start'));
    destination.searchParams.set('mediaType', selected.mediaType);
    destination.searchParams.set('tmdbId', String(selected.tmdbId));
    destination.searchParams.set('rating', String(value));
    window.location.assign(destination.toString());
  });

  const focusRegion = [carouselControls, form, ...details, ...modeButtons].filter(
    Boolean,
  ) as HTMLElement[];
  focusRegion.forEach((region) => {
    region.addEventListener('focusin', () => {
      controlsFocused = true;
      clearRotation();
    });
    region.addEventListener('focusout', () => {
      window.setTimeout(() => {
        controlsFocused = focusRegion.some((candidate) =>
          candidate.contains(document.activeElement),
        );
        if (!controlsFocused) scheduleRotation();
      });
    });
  });

  document.addEventListener('tenagain:landing-view', (event) => {
    if ((event as CustomEvent<string>).detail === 'score') scheduleRotation();
    else {
      clearRotation();
      pixelHero?.cancel();
      canvas?.classList.remove('is-active');
      revealCopy();
    }
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) clearRotation();
    else scheduleRotation();
  });
  window.addEventListener('resize', () => {
    if (resizeTimer !== undefined) window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      if (
        !document.body.dataset.landingView ||
        document.body.dataset.landingView === 'score'
      )
        select(activeIndex);
    }, 180);
  });
  window.addEventListener('pagehide', () => pixelHero?.destroy(), { once: true });

  resetScore();
  select(activeIndex, false);
</script>

<style>
  .campaign-hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #050505;
    color: #fff;
    isolation: isolate;
  }
  .campaign-hero__backdrops,
  .campaign-hero__backdrop,
  .campaign-hero__backdrop picture,
  .campaign-hero__backdrop img,
  .campaign-hero__pixel-canvas,
  .campaign-hero__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .campaign-hero__backdrops {
    z-index: -1;
  }
  .campaign-hero__backdrop {
    opacity: 0;
    overflow: hidden;
    transition: opacity 500ms var(--ease-soft);
  }
  .campaign-hero__backdrop.is-active {
    opacity: 1;
  }
  .campaign-hero__backdrop img {
    object-fit: cover;
    object-position: center;
    filter: saturate(1.1) contrast(1.03);
  }
  .campaign-hero__pixel-canvas {
    z-index: 2;
    opacity: 0;
    object-fit: cover;
    transition: opacity 220ms ease;
  }
  .campaign-hero__pixel-canvas.is-active {
    opacity: 1;
  }
  .campaign-hero__scrim {
    z-index: 3;
    background:
      linear-gradient(
        to top,
        #050505 0%,
        rgba(5, 5, 5, 0.65) 19%,
        transparent 60%
      ),
      linear-gradient(to right, rgba(5, 5, 5, 0.45), transparent 65%),
      linear-gradient(to bottom, rgba(5, 5, 5, 0.45), transparent 25%);
  }
  .campaign-hero__stage {
    display: grid;
    width: min(100%, 90rem);
    min-height: 100svh;
    margin: 0 auto;
    padding: 9rem clamp(1.5rem, 5vw, 4.5rem) 9rem;
    grid-template-columns: minmax(0, 1fr) 25rem;
    align-items: end;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .campaign-hero__identity {
    display: flex;
    min-width: 0;
    align-items: end;
    gap: clamp(1rem, 2vw, 1.8rem);
  }
  .campaign-hero__poster-stack {
    position: relative;
    width: clamp(4.5rem, 7vw, 6rem);
    aspect-ratio: 2 / 3;
    flex: 0 0 auto;
  }
  .campaign-hero__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 1px solid #ffffff80;
    object-fit: cover;
    opacity: 0;
    box-shadow: 3px 3px 0 #ffffff40;
    transition: opacity 260ms ease;
  }
  .campaign-hero__poster.is-active {
    opacity: 1;
  }
  .campaign-hero__copy {
    min-width: 0;
  }
  .campaign-hero__details {
    position: relative;
    display: none;
  }
  .campaign-hero__details.is-active {
    display: block;
  }
  .campaign-hero h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5.2vw, 4.8rem);
    line-height: 0.88;
    letter-spacing: 0.015em;
    text-wrap: balance;
  }
  .campaign-hero__title {
    display: block;
    position: relative;
    text-align: left;
