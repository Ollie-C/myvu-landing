---
import { APP_URL } from '../config';

const initialRedirect = encodeURIComponent('/discover?mediaType=tv_show');
---

<a href="#main-content" class="skip-link">Skip to main content</a>

<header class="landing-nav">
  <nav class="landing-nav__inner" aria-label="Main navigation">
    <a href="/" class="landing-nav__brand" aria-label="tenagain home">TA</a>

    <div class="media-switcher" role="radiogroup" aria-label="Media type">
      <button type="button" role="radio" aria-label="Movies" aria-checked="false" class="media-switcher__option" tabindex="-1" data-mode-option="movie">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="14" height="14" rx="1"/><path d="M7 3v14M13 3v14M3 7h4m-4 6h4m6-6h4m-4 6h4"/></svg>Movies
      </button>
      <button type="button" role="radio" aria-label="TV" aria-checked="true" class="media-switcher__option is-active" data-mode-option="tv_show">
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="2.5" y="5" width="15" height="11" rx="1"/><path d="m7 2 3 3 3-3M7 18h6"/></svg>TV
      </button>
    </div>

    <div class="landing-nav__actions">
      <a href={`${APP_URL}/login?redirect=${initialRedirect}`} class="landing-nav__signin" data-app-signin>Sign in</a>
      <a href={APP_URL} class="landing-nav__open"><span class="open-label-wide">Open tenagain</span><span class="open-label-small">Open app</span><span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>

<style>
  .landing-nav__signin {white-space:nowrap}
  .open-label-small {display:none}
  @media(max-width:639px){.open-label-small{display:inline}.open-label-wide{display:none}}
</style>
